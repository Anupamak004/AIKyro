# SMTP settings are required only when you want to send email through the MCP tool.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Optional LLM endpoint (OpenAI-compatible). Without it, answers use retrieved dialogue excerpts.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
